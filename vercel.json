{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/status"
    },
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/explorer",
      "destination": "/api/explorer"
    },
    {
      "source": "/attestations",
      "destination": "/api/attestations"
    },
    {
      "source": "/attestations/:path*",
      "destination": "/api/attestations/:path*"
    },
    {
      "source": "/webhooks",
      "destination": "/api/webhooks"
    },
    {
      "source": "/c2b/confirm",
      "destination": "/api/mpesa/c2b/callback"
    }
  ]
}
