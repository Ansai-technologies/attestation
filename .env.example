# --- Supabase (hash-chained attestations table) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ed25519 attestation signing keys (PEM) ---
# Generate locally: node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'pem'}));console.log(k.publicKey.export({type:'spki',format:'pem'}))"
# NEVER commit real keys. In production these come from a secrets manager.
ED25519_PRIVATE_KEY_PEM=
ED25519_PUBLIC_KEY_PEM=

# --- Daraja (Safaricom M-Pesa API), sandbox first ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
# Security credential (encrypted initiator password) for transaction-status queries
DARAJA_SECURITY_CREDENTIAL=

# --- C2B callback source allowlist (comma-separated IPs/CIDRs, optional) ---
MPESA_CALLBACK_ALLOWLIST=

# --- Webhook registration admin secret ---
# POST /webhooks requires: Authorization: Bearer <WEBHOOK_ADMIN_SECRET>
# Generate: openssl rand -hex 32. When unset, registration returns 503 (fail closed).
WEBHOOK_ADMIN_SECRET=
